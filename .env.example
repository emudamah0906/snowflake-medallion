# Copy this file to .env and fill in your own values.
# .env is ignored by Git. This example file is not, so others know what to set.
#
# Load it before running dbt:   source .env   (or: source ../.env from dbt/)

export SNOWFLAKE_ACCOUNT="<orgname>-<accountname>"
export SNOWFLAKE_PRIVATE_KEY_PATH="$HOME/.snowflake/keys/svc_dbt_key.p8"
